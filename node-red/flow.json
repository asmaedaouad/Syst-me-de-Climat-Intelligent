    {
        "id": "571f8bedebc19b67",
        "type": "function",
        "z": "cfbb5c51bf9246ef",
        "name": "Function: Prepare Data",
        "func": "// Convertir payload string en objet si nécessaire\nif (typeof msg.payload === \"string\") {\n    try {\n        msg.payload = JSON.parse(msg.payload);\n    } catch (e) {\n        node.error(\"JSON invalide reçu !\");\n        return null;\n    }\n}\n\nlet d = msg.payload;\n\n// Vérifications\nif (!d.year || !d.month || !d.day || !d.hour || d.indoor_temp === undefined) {\n    node.error(\"Champs manquants !\");\n    return null;\n}\n\n// --- Sortie 1 : SQL ---\nlet msgSQL = { ...msg }; // copie de msg pour SQL\nmsgSQL.topic = `\nINSERT INTO TempData2020_2025\n    (year, month, day, hour, indoor_temp, heater_level, fan_level)\nVALUES\n    (${d.year}, ${d.month}, ${d.day}, '${d.hour}', ${d.indoor_temp}, ${d.heater_level}, ${d.fan_level});\n`;\n\n// --- Sortie 2 : WhatsApp ---\nlet msgWhats = { ...msg }; // copie de msg pour WhatsApp\nmsgWhats.payload = `📡 Nouvelle mesure reçue\n🌡 Température : ${d.indoor_temp} °C\n🔥 Chauffage : ${d.heater_level}\n💨 Ventilateur : ${d.fan_level}\n🕒 Heure : ${d.hour}`;\n\n// Si ton nœud WhatsApp n'a pas de numéro fixe\nmsgWhats.to = \"+212XXXXXXXXX\";\n\n// Retourner les 2 sorties\nreturn [msgSQL, msgWhats];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
